<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.acme</groupId>
  <artifactId>acme-parent-pom</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Acme Parent POM</name>

  <properties>
    <!-- Runtime -->
    <app.runtime>4.12.5</app.runtime>
    <java.version>17</java.version>

    <!-- Plugin versions -->
    <mule.maven.plugin.version>4.7.0</mule.maven.plugin.version>
    <munit.version>3.2.0</munit.version>

    <!-- Connector versions (kept at current app values; no N-1 sweep performed) -->
    <mule.apikit.version>1.10.0</mule.apikit.version>
    <mule.a2a.version>1.1.1</mule.a2a.version>
    <mule.mcp.version>1.6.0</mule.mcp.version>
    <mule.sockets.version>1.2.7</mule.sockets.version>
    <mule.http.version>1.11.1</mule.http.version>

    <!-- Anypoint organization (Business Group) ID -->
    <anypoint.org.id>0d2dd5dc-4a01-4180-a12a-0c3c4d888c7b</anypoint.org.id>

    <!-- CloudHub 2.0 deployment defaults; override per app/environment via -D on the CLI. -->
    <anypoint.environment>Sandbox</anypoint.environment>
    <anypoint.private.space>mcp-private-space</anypoint.private.space>
    <cloudhub2.replicas>1</cloudhub2.replicas>
    <cloudhub2.vcores>0.1</cloudhub2.vcores>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- ================================================================
       Connector version management — child apps omit <version> tags.
       ================================================================ -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.mule.modules</groupId>
        <artifactId>mule-apikit-module</artifactId>
        <version>${mule.apikit.version}</version>
        <classifier>mule-plugin</classifier>
      </dependency>
      <dependency>
        <groupId>com.mulesoft.connectors</groupId>
        <artifactId>mule4-a2a-connector</artifactId>
        <version>${mule.a2a.version}</version>
        <classifier>mule-plugin</classifier>
      </dependency>
      <dependency>
        <groupId>com.mulesoft.connectors</groupId>
        <artifactId>mule-mcp-connector</artifactId>
        <version>${mule.mcp.version}</version>
        <classifier>mule-plugin</classifier>
      </dependency>
      <dependency>
        <groupId>org.mule.connectors</groupId>
        <artifactId>mule-sockets-connector</artifactId>
        <version>${mule.sockets.version}</version>
        <classifier>mule-plugin</classifier>
      </dependency>
      <dependency>
        <groupId>org.mule.connectors</groupId>
        <artifactId>mule-http-connector</artifactId>
        <version>${mule.http.version}</version>
        <classifier>mule-plugin</classifier>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.mule.tools.maven</groupId>
          <artifactId>mule-maven-plugin</artifactId>
          <version>${mule.maven.plugin.version}</version>
          <extensions>true</extensions>
        </plugin>
        <plugin>
          <groupId>com.mulesoft.munit.tools</groupId>
          <artifactId>munit-maven-plugin</artifactId>
          <version>${munit.version}</version>
          <executions>
            <execution>
              <id>test</id>
              <phase>test</phase>
              <goals>
                <goal>test</goal>
                <goal>coverage-report</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <coverage>
              <runCoverage>false</runCoverage>
            </coverage>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- ================================================================
       Exchange publish target.
       ================================================================ -->
  <distributionManagement>
    <repository>
      <id>anypoint-exchange-v3</id>
      <name>Anypoint Exchange V3</name>
      <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.org.id}/maven</url>
    </repository>
  </distributionManagement>

  <repositories>
    <repository>
      <id>anypoint-exchange-v3</id>
      <name>Anypoint Exchange V3</name>
      <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
      <layout>default</layout>
    </repository>
    <repository>
      <id>mulesoft-releases</id>
      <name>MuleSoft Releases Repository</name>
      <url>https://repository.mulesoft.org/releases/</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>mulesoft-releases</id>
      <name>MuleSoft Releases Repository</name>
      <url>https://repository.mulesoft.org/releases/</url>
    </pluginRepository>
  </pluginRepositories>

  <!-- ================================================================
       CloudHub 2.0 deployment profile.
       Activated with -Pcloudhub2 on the Maven command line.
       Credentials are read from environment variables injected by the
       CI pipeline — they are never stored in this file.
       ================================================================ -->
  <profiles>
    <profile>
      <id>cloudhub2</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.mule.tools.maven</groupId>
            <artifactId>mule-maven-plugin</artifactId>
            <version>${mule.maven.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <cloudHub2Deployment>
                <uri>https://anypoint.mulesoft.com</uri>
                <provider>MC</provider>
                <environment>${anypoint.environment}</environment>
                <target>${anypoint.private.space}</target>
                <muleVersion>${app.runtime}</muleVersion>
                <javaVersion>${java.version}</javaVersion>
                <applicationName>${project.artifactId}</applicationName>
                <replicas>${cloudhub2.replicas}</replicas>
                <vCores>${cloudhub2.vcores}</vCores>
                <connectedAppClientId>${env.ANYPOINT_CLIENT_ID}</connectedAppClientId>
                <connectedAppClientSecret>${env.ANYPOINT_CLIENT_SECRET}</connectedAppClientSecret>
                <connectedAppGrantType>client_credentials</connectedAppGrantType>
                <businessGroupId>${anypoint.org.id}</businessGroupId>
              </cloudHub2Deployment>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
